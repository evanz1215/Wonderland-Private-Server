<Window x:Class="WloCharacterViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WloCharacterViewer.ViewModels"
        xmlns:views="clr-namespace:WloCharacterViewer.Views"
        mc:Ignorable="d"
        Title="WLO Bot Tool" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cdd6f4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#313244" />
            <Setter Property="Foreground" Value="#cdd6f4" />
            <Setter Property="BorderBrush" Value="#585b70" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#89b4fa" />
            <Setter Property="Foreground" Value="#1e1e2e" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Login Panel -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                Visibility="{Binding IsNotInGame, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="WLO Bot Tool" FontSize="20" FontWeight="Bold" Foreground="#cba6f7" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="55" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Host:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />

                    <TextBlock Grid.Column="3" Text="Port:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="4" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />

                    <TextBlock Grid.Column="6" Text="User:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="7" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputStyle}" />

                    <TextBlock Grid.Column="9" Text="Pass:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0" />
                    <PasswordBox Grid.Column="10" x:Name="PasswordBox"
                                 Background="#313244" Foreground="#cdd6f4" BorderBrush="#585b70"
                                 Padding="6,4" FontSize="13"
                                 PasswordChanged="PasswordBox_PasswordChanged" />

                    <TextBlock Grid.Column="12" Text="Slot:" Style="{StaticResource LabelStyle}" Margin="0,0,6,0" />
                    <ComboBox Grid.Column="13" SelectedIndex="0" SelectionChanged="SlotCombo_SelectionChanged"
                              x:Name="SlotCombo"
                              Background="#313244" Foreground="#cdd6f4" BorderBrush="#585b70"
                              Padding="6,3" FontSize="13" MinWidth="50">
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                    </ComboBox>

                    <Button Grid.Column="15" Content="Login" Command="{Binding LoginCommand}" Style="{StaticResource ButtonStyle}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- In-Game Header -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Disconnect" Command="{Binding DisconnectCommand}"
                        Background="#f38ba8" Foreground="#1e1e2e" FontWeight="Bold" FontSize="13"
                        Padding="16,6" BorderThickness="0" Cursor="Hand" />
                <TextBlock FontSize="18" FontWeight="Bold" Foreground="#cba6f7" VerticalAlignment="Center">
                    <Run Text="WLO Bot Tool" />
                    <Run Text=" - " Foreground="#585b70" />
                    <Run Text="{Binding DashboardVM.Character.Name, Mode=OneWay, FallbackValue=''}" Foreground="#89b4fa" />
                </TextBlock>
            </DockPanel>
        </Border>

        <!-- Pre-login placeholder -->
        <Border Grid.Row="1" Background="#181825" CornerRadius="8" Padding="16"
                Visibility="{Binding IsNotInGame, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Enter login credentials above" FontSize="16" Foreground="#6c7086" HorizontalAlignment="Center" />
                <TextBlock Text="Select Slot 1 or 2, then click Login" FontSize="13" Foreground="#585b70" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- In-Game TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0"
                    Visibility="{Binding IsInGame, Converter={StaticResource BoolToVis}}"
                    Padding="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="#181825" />
                    <Setter Property="Foreground" Value="#6c7086" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border" Background="#181825" CornerRadius="6,6,0,0"
                                        Padding="{TemplateBinding Padding}" Margin="2,0,2,0">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#313244" />
                                        <Setter Property="Foreground" Value="#cdd6f4" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#45475a" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Dashboard">
                <Border Background="#181825" CornerRadius="0,6,6,6">
                    <views:DashboardView DataContext="{Binding DashboardVM}" />
                </Border>
            </TabItem>
            <TabItem Header="Chat">
                <Border Background="#181825" CornerRadius="0,6,6,6">
                    <views:ChatView DataContext="{Binding ChatVM}" />
                </Border>
            </TabItem>
            <TabItem Header="Inventory">
                <Border Background="#181825" CornerRadius="0,6,6,6">
                    <views:InventoryView DataContext="{Binding InventoryVM}" />
                </Border>
            </TabItem>
            <TabItem Header="Auto Battle">
                <Border Background="#181825" CornerRadius="0,6,6,6">
                    <views:BattleBotView DataContext="{Binding BattleBotVM}" />
                </Border>
            </TabItem>
            <TabItem Header="Navigation">
                <Border Background="#181825" CornerRadius="0,6,6,6">
                    <views:NavigationView DataContext="{Binding NavigationVM}" />
                </Border>
            </TabItem>
            <TabItem Header="Packet Log">
                <Border Background="#181825" CornerRadius="0,6,6,6" Padding="12">
                    <TextBox Text="{Binding RawPacketLog, Mode=OneWay}" IsReadOnly="True"
                             Background="#11111b" Foreground="#6c7086" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="8,6" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="#f9e2af" FontSize="12" />
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Background="#80000000" CornerRadius="8"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Processing..." FontSize="20" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
