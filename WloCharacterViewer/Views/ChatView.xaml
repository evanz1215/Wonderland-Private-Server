<UserControl x:Class="WloCharacterViewer.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#cdd6f4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Message List -->
        <Border Grid.Row="0" Background="#11111b" CornerRadius="6" Padding="8" Margin="0,0,0,8">
            <ListBox ItemsSource="{Binding Messages}" Background="Transparent" BorderThickness="0"
                     Foreground="#cdd6f4" FontFamily="Consolas" FontSize="12"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     x:Name="ChatList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Input Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0" SelectedIndex="1" Margin="0,0,8,0"
                      Background="#313244" Foreground="#cdd6f4" BorderBrush="#585b70"
                      x:Name="ChannelCombo" SelectionChanged="ChannelCombo_SelectionChanged">
                <ComboBoxItem Content="Whisper" Tag="1" />
                <ComboBoxItem Content="Local" Tag="2" />
                <ComboBoxItem Content="Party" Tag="3" />
                <ComboBoxItem Content="World" Tag="5" />
            </ComboBox>

            <TextBox Grid.Column="1" Text="{Binding WhisperTarget, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#cdd6f4" BorderBrush="#585b70"
                     Width="100" Margin="0,0,8,0" Padding="4,4"
                     Visibility="{Binding IsWhisper, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}" />

            <TextBox Grid.Column="2" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                     Background="#313244" Foreground="#cdd6f4" BorderBrush="#585b70"
                     Padding="6,4" FontSize="13" Margin="0,0,8,0"
                     KeyDown="InputBox_KeyDown" />

            <Button Grid.Column="3" Content="Send" Command="{Binding SendCommand}"
                    Background="#89b4fa" Foreground="#1e1e2e" FontWeight="Bold"
                    Padding="16,4" BorderThickness="0" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>
