<UserControl x:Class="WloCharacterViewer.Views.NavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="#cdd6f4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Current Position -->
        <Border Grid.Row="0" Background="#313244" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Current Position" FontSize="14" FontWeight="Bold" Foreground="#cba6f7" Margin="0,0,0,8" />
                <TextBlock>
                    <Run Text="Map: " Foreground="#6c7086" /><Run Text="{Binding Map.MapId, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="  X: " Foreground="#6c7086" /><Run Text="{Binding Map.X, Mode=OneWay}" FontWeight="Bold" />
                    <Run Text="  Y: " Foreground="#6c7086" /><Run Text="{Binding Map.Y, Mode=OneWay}" FontWeight="Bold" />
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Add Waypoint -->
        <Border Grid.Row="1" Background="#313244" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Add Waypoint" FontSize="14" FontWeight="Bold" Foreground="#cba6f7" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Map:" Foreground="#6c7086" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Column="1" Text="{Binding WpMapId, UpdateSourceTrigger=PropertyChanged}"
                             Background="#45475a" Foreground="#cdd6f4" BorderBrush="#585b70" Padding="4" />
                    <TextBlock Grid.Column="3" Text="X:" Foreground="#6c7086" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Column="4" Text="{Binding WpX, UpdateSourceTrigger=PropertyChanged}"
                             Background="#45475a" Foreground="#cdd6f4" BorderBrush="#585b70" Padding="4" />
                    <TextBlock Grid.Column="6" Text="Y:" Foreground="#6c7086" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Grid.Column="7" Text="{Binding WpY, UpdateSourceTrigger=PropertyChanged}"
                             Background="#45475a" Foreground="#cdd6f4" BorderBrush="#585b70" Padding="4" />
                    <Button Grid.Column="9" Content="Current" Command="{Binding UseCurrentPosCommand}"
                            Background="#585b70" Foreground="#cdd6f4" Padding="8,4" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" />
                    <Button Grid.Column="10" Content="Add" Command="{Binding AddWaypointCommand}"
                            Background="#89b4fa" Foreground="#1e1e2e" FontWeight="Bold" Padding="12,4" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand" />
                    <Button Grid.Column="11" Content="Clear" Command="{Binding ClearWaypointsCommand}"
                            Background="#f38ba8" Foreground="#1e1e2e" FontWeight="Bold" Padding="12,4" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Waypoint List -->
        <Border Grid.Row="2" Background="#11111b" CornerRadius="6" Padding="8">
            <ListBox ItemsSource="{Binding AutoWalk.Waypoints}" Background="Transparent" BorderThickness="0"
                     Foreground="#cdd6f4" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="4,2" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Walk Controls -->
        <Border Grid.Row="3" Background="#313244" CornerRadius="6" Padding="12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="Enable Auto Walk" IsChecked="{Binding AutoWalk.Enabled}" Foreground="#cdd6f4" Margin="0,0,16,0" />
                <CheckBox Content="Loop" IsChecked="{Binding AutoWalk.Loop}" Foreground="#cdd6f4" Margin="0,0,16,0" />
                <TextBlock Foreground="#6c7086" VerticalAlignment="Center">
                    <Run Text="Current: " /><Run Text="{Binding AutoWalk.CurrentIndex, Mode=OneWay}" FontWeight="Bold" Foreground="#a6e3a1" />
                    <Run Text=" / " /><Run Text="{Binding AutoWalk.Waypoints.Count, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
