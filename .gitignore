[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.psess
*.vspx

# NuGet
packages/
*.nupkg

# Build logs
BuildLog.txt
msbuild.log
msbuild.wrn
msbuild.err

