*.log
mylogfile.txt
Log/

# Temp files
*.tmp
*.temp
~$*
TemporaryGeneratedFile_*.cs

# Old merge artifacts
*.BACKUP.*
*.BASE.*
*.LOCAL.*
*.REMOTE.*

# GupdtSrv (update system)
/GupdtSrv/

# Misc
*.rar
*.zip
U1.txt
U2.txt
Wonderland-Online-Private-Server/

# Claude Code
.claude/
