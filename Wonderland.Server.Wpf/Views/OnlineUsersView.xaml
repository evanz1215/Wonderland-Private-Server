<UserControl x:Class="WonderlandServerWpf.Views.OnlineUsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="玩家列表" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="查看線上玩家與所有角色資料" FontSize="13"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- ══ Tab 1: 線上玩家 ══ -->
            <TabItem Header="線上玩家">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Stats Bar + Search + Actions -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,12">
                        <DockPanel>
                            <!-- Right: Actions -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="踢除玩家" Command="{Binding KickCommand}"
                                        Style="{StaticResource DangerButton}" Padding="12,6" FontSize="12"
                                        Margin="0,0,8,0" />
                                <Button Content="重新整理" Command="{Binding RefreshCommand}"
                                        Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" />
                            </StackPanel>

                            <!-- Left: Stats + Search -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Online Count Badge -->
                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="12"
                                        Padding="12,4" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding OnlineCountText}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <!-- Map Count -->
                                <TextBlock Text="{Binding MapCountText}" FontSize="12"
                                           Foreground="{DynamicResource FgMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,16,0" />

                                <!-- Search -->
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="200" />

                                <!-- Last Refresh -->
                                <TextBlock Text="{Binding LastRefreshText}" FontSize="11"
                                           Foreground="{DynamicResource FgMutedBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Player DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Players}"
                              SelectedItem="{Binding SelectedPlayer}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="增加金幣..." Command="{Binding AddGoldCommand}" />
                                <MenuItem Header="增加商城點數..." Command="{Binding AddIMCommand}" />
                                <MenuItem Header="增加紅利點數..." Command="{Binding AddBonusCommand}" />
                                <Separator />
                                <MenuItem Header="設定等級..." Command="{Binding SetLevelCommand}" />
                                <MenuItem Header="完全恢復 HP/SP" Command="{Binding HealCommand}" />
                                <Separator />
                                <MenuItem Header="傳送..." Command="{Binding TeleportCommand}" />
                                <MenuItem Header="踢除玩家" Command="{Binding KickCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="角色 ID" Binding="{Binding CharID}" Width="80" />
                            <DataGridTextColumn Header="角色名稱" Binding="{Binding CharName}" Width="140" />
                            <DataGridTextColumn Header="帳號" Binding="{Binding UserName}" Width="120" />
                            <DataGridTextColumn Header="等級" Binding="{Binding Level}" Width="60" />
                            <DataGridTextColumn Header="HP" Binding="{Binding HPDisplay}" Width="110" />
                            <DataGridTextColumn Header="金幣" Binding="{Binding GoldDisplay}" Width="100" />
                            <DataGridTextColumn Header="商城點數" Binding="{Binding IM}" Width="90" />
                            <DataGridTextColumn Header="紅利點數" Binding="{Binding BonusPoints}" Width="90" />
                            <DataGridTextColumn Header="地圖" Binding="{Binding MapID}" Width="70" />
                            <DataGridTextColumn Header="座標" Binding="{Binding PositionDisplay}" Width="90" />
                            <DataGridTextColumn Header="IP" Binding="{Binding IP}" Width="130" />
                            <DataGridTextColumn Header="狀態" Binding="{Binding Status}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ══ Tab 2: 所有玩家 ══ -->
            <TabItem Header="所有玩家">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Stats Bar + Search -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,8,0,12">
                        <DockPanel>
                            <!-- Right: Refresh -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="重新整理" Command="{Binding RefreshAllPlayersCommand}"
                                        Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12" />
                            </StackPanel>

                            <!-- Left: Count + Search -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Count Badge -->
                                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="12"
                                        Padding="12,4" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding AllPlayersCountText}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="White" />
                                </Border>

                                <!-- Search -->
                                <TextBox Text="{Binding AllPlayersSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Width="200" />

                                <!-- Last Refresh -->
                                <TextBlock Text="{Binding AllPlayersLastRefreshText}" FontSize="11"
                                           Foreground="{DynamicResource FgMutedBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- All Players DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding AllPlayers}"
                              SelectedItem="{Binding SelectedAllPlayer}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="角色 ID" Binding="{Binding CharID}" Width="80" />
                            <DataGridTextColumn Header="角色名稱" Binding="{Binding CharName}" Width="160" />
                            <DataGridTextColumn Header="等級" Binding="{Binding Level}" Width="60" />
                            <DataGridTextColumn Header="金幣" Binding="{Binding GoldDisplay}" Width="120" />
                            <DataGridTextColumn Header="屬性" Binding="{Binding Element}" Width="80" />
                            <DataGridTextColumn Header="轉職" Binding="{Binding Job}" Width="100" />
                            <DataGridTextColumn Header="地圖" Binding="{Binding MapID}" Width="70" />
                            <DataGridTextColumn Header="座標" Binding="{Binding PositionDisplay}" Width="90" />
                            <DataGridTextColumn Header="狀態" Binding="{Binding StatusDisplay}" Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Bar -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Content="&#x00AB; 首頁" Command="{Binding FirstPageCommand}"
                                    Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0" />
                            <Button Content="&#x2039; 上一頁" Command="{Binding PrevPageCommand}"
                                    Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding PageInfoText}" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="下一頁 &#x203A;" Command="{Binding NextPageCommand}"
                                    Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" Margin="0,0,4,0" />
                            <Button Content="末頁 &#x00BB;" Command="{Binding LastPageCommand}"
                                    Style="{StaticResource GhostButton}" Padding="10,4" FontSize="12" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
