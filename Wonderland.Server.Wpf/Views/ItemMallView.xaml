<UserControl x:Class="WonderlandServerWpf.Views.ItemMallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="商城管理" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="將左側道具移至右側即可上架，支援搜尋與批次操作" FontSize="13"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Transfer Panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Left Panel: Available Items ═══ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0" Margin="0,0,8,0">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgMediumBrush}"
                            CornerRadius="8,8,0,0" Padding="14,10">
                        <DockPanel>
                            <TextBlock Text="可上架道具" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgSecondaryBrush}" />
                            <TextBlock Text="{Binding AvailableCountText}" FontSize="12"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Search + Select All -->
                    <Border DockPanel.Dock="Top" Padding="10,8">
                        <DockPanel>
                            <Button Content="全選" Command="{Binding SelectAllAvailableCommand}"
                                    DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding AvailableSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>

                    <!-- Item List -->
                    <ListBox ItemsSource="{Binding FilteredAvailableItems}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayText}" FontSize="12"
                                               Foreground="{DynamicResource FgPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ═══ Center: Transfer Buttons ═══ -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                <Button Content="&#x25B6;" Command="{Binding MoveToMallCommand}"
                        Width="44" Height="44" FontSize="16" Margin="0,0,0,12"
                        ToolTip="上架選取的道具" />
                <Button Content="&#x25C0;" Command="{Binding MoveFromMallCommand}"
                        Width="44" Height="44" FontSize="16"
                        Style="{StaticResource GhostButton}"
                        ToolTip="下架選取的道具" />
            </StackPanel>

            <!-- ═══ Right Panel: Mall Items ═══ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" Margin="8,0,0,0">
                <DockPanel>
                    <!-- Header -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BgMediumBrush}"
                            CornerRadius="8,8,0,0" Padding="14,10">
                        <DockPanel>
                            <TextBlock Text="已上架道具" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding MallCountText}" FontSize="12"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <!-- Search + Select All -->
                    <Border DockPanel.Dock="Top" Padding="10,8">
                        <DockPanel>
                            <Button Content="全選" Command="{Binding SelectAllMallCommand}"
                                    DockPanel.Dock="Right" Padding="10,4" FontSize="11"
                                    Style="{StaticResource GhostButton}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding MallSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>

                    <!-- Item List -->
                    <ListBox ItemsSource="{Binding FilteredMallItems}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,2">
                                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding DisplayTextWithPrice}" FontSize="12"
                                               Foreground="{DynamicResource FgPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ Bottom: Default Settings + Actions ═══ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <!-- Right: Action Buttons -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="儲存設定" Command="{Binding SaveCommand}" Margin="0,0,8,0" />
                    <Button Content="清空全部" Command="{Binding ClearAllCommand}"
                            Style="{StaticResource DangerButton}" />
                </StackPanel>

                <!-- Left: Default settings for new items -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="上架預設值：" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <TextBlock Text="分頁" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding TabOptions}" SelectedIndex="{Binding DefaultTab}"
                              Width="100" />

                    <TextBlock Text="價格" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="16,0,6,0" />
                    <TextBox Text="{Binding DefaultPrice, UpdateSourceTrigger=PropertyChanged}" Width="60" />

                    <TextBlock Text="數量" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="16,0,6,0" />
                    <TextBox Text="{Binding DefaultAmount, UpdateSourceTrigger=PropertyChanged}" Width="50" />

                    <TextBlock Text="折扣(%)" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource FgSecondaryBrush}" Margin="16,0,6,0" />
                    <TextBox Text="{Binding DefaultDiscount, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
