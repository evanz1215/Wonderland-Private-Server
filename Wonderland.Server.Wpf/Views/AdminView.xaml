<UserControl x:Class="WonderlandServerWpf.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="管理面板" FontSize="22" FontWeight="Bold" />
            <TextBlock Text="資料庫連線與伺服器管理" FontSize="13"
                       Foreground="{DynamicResource FgMutedBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- Database Config -->
            <TabItem Header="資料庫設定">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <GroupBox Header="資料庫連線">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="伺服器 IP" Grid.Row="0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding DbServerIP, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" />

                                <TextBlock Text="Port" Grid.Row="1" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" />

                                <TextBlock Text="使用者" Grid.Row="2" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />

                                <TextBlock Text="密碼" Grid.Row="3" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding DbPass, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />

                                <TextBlock Text="資料庫名稱" Grid.Row="4" VerticalAlignment="Center"
                                           Foreground="{DynamicResource FgSecondaryBrush}" />
                                <TextBox Text="{Binding DbDatabase, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </GroupBox>

                        <Button Content="儲存設定" Command="{Binding SaveCommand}"
                                HorizontalAlignment="Right" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Node Network -->
            <TabItem Header="節點網路">
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <TextBlock Text="節點網路設定（開發中）" FontSize="14"
                               Foreground="{DynamicResource FgMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
